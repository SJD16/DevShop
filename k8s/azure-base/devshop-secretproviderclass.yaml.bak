apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: devshop-secrets
  namespace: devshop

spec:
  provider: azure

  parameters:
    usePodIdentity: "false"
    useVMManagedIdentity: "true"
    userAssignedIdentityID: "3747c845-cb3c-44c0-b996-dfe42c5503f4"
    keyvaultName: "REPLACEWITHYOURKEYVAULTNAME"
    cloudName: ""
    tenantId: "REPLACEWITHYOURAZURETENANTID"

    objects: |
      array:
        - |
          objectName: jwt-secret-key
          objectType: secret
          objectAlias: JWTSECRETKEY
        - |
          objectName: db-password
          objectType: secret
          objectAlias: DBPASSWORD
        - |
          objectName: database-url
          objectType: secret
          objectAlias: DATABASEURL

  secretObjects:
    - secretName: devshop-secret
      type: Opaque
      data:
        - objectName: JWTSECRETKEY
          key: JWTSECRETKEY
        - objectName: DBPASSWORD
          key: DBPASSWORD
        - objectName: DATABASEURL
          key: DATABASEURL